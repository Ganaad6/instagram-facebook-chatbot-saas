# --- Database -------------------------------------------------------------------------
# For `mvn spring-boot:run` against a local Postgres:
DATABASE_URL=jdbc:postgresql://localhost:5432/chatbot_saas
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
# For docker compose: three separate roles (superuser for init only, the app, and Directus).
# Generate each with e.g. `openssl rand -base64 24`. Changing these after the database volume
# was created has no effect - see README "Upgrading an existing database volume".
POSTGRES_SUPERUSER_PASSWORD=set_a_unique_random_value_here
APP_DB_PASSWORD=set_a_unique_random_value_here
DIRECTUS_DB_PASSWORD=set_a_unique_random_value_here
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
BASE_URL=http://localhost:8080
WEBHOOK_VERIFY_TOKEN=your_verify_token
# Graph API version used for all Meta calls - bump before Meta deprecates it
META_GRAPH_API_VERSION=v23.0
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
# INFO in production; DEBUG logs customer IDs and message metadata
LOG_LEVEL=INFO
# "native" trusts X-Forwarded-For only from private-network proxies; "none" if no proxy
FORWARD_HEADERS_STRATEGY=native
# Idle hours before an unfinished chatbot order conversation is abandoned
CHATBOT_CONVERSATION_TIMEOUT_HOURS=24
# Hours the bot stays silent for a customer after they ask for a person or staff reply
CHATBOT_HANDOFF_TIMEOUT_HOURS=12

# Admin operator credentials - protect /api/admin/** (list/suspend/activate/rotate-key businesses).
# Change these before deploying; startup will refuse to run with these defaults when
# SPRING_PROFILES_ACTIVE=prod.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying

# Signs the OAuth "state" parameter so the public /api/auth/meta/callback redirect can be
# trusted. Must be a different value than ENCRYPTION_SECRET_KEY.
OAUTH_STATE_SECRET=set_a_unique_random_value_here
# How long a Facebook/Instagram connect link stays valid, in minutes
OAUTH_STATE_TTL_MINUTES=60

# QPay merchant API. Each shop connects its own QPay merchant account through the API, so no
# QPay credentials go here. The sandbox (default) never moves real money; production must use
# https://merchant.qpay.mn/v2 - startup refuses the sandbox when SPRING_PROFILES_ACTIVE=prod.
# QPay sends payment callbacks to ${BASE_URL}/webhook/qpay/{orderId}.
QPAY_API_URL=https://merchant-sandbox.qpay.mn/v2

# Public base URL of the Directus instance (see docker-compose.yml) used to build shop owners'
# product photo URLs (${DIRECTUS_PUBLIC_URL}/assets/{image_file_id}) sent to customers in chat.
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_KEY=set_a_unique_random_value_here
DIRECTUS_SECRET=set_a_unique_random_value_here
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_me_before_deploying
