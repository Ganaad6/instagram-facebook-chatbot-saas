# Copy to .env and fill in. `docker compose up -d --build` reads it.
# Generate secrets with e.g.:  openssl rand -base64 24   (ENCRYPTION_SECRET_KEY: openssl rand -hex 16)

# --- Where the app lives -------------------------------------------------------------------
# Your domain; its DNS A record must point at this server (ports 80 and 443 open). Caddy gets
# the HTTPS certificate automatically. Use DOMAIN=localhost and BASE_URL=https://localhost to
# try the stack on your own machine (self-signed certificate).
DOMAIN=shop.example.mn
BASE_URL=https://shop.example.mn
# prod: refuses to start with insecure settings (see SecurityPropertiesValidator), HTTPS-only cookies
SPRING_PROFILES_ACTIVE=prod
# Timestamps and "today" in the dashboard use this zone
TZ=Asia/Ulaanbaatar

# --- Database ------------------------------------------------------------------------------
# Separate roles: superuser (init only) and the app. Changing these after the database volume
# was created has no effect - see README "Upgrading an existing database volume".
POSTGRES_SUPERUSER_PASSWORD=set_a_unique_random_value_here
APP_DB_PASSWORD=set_a_unique_random_value_here
# For `mvn spring-boot:run` against a local Postgres instead of docker compose:
DATABASE_URL=jdbc:postgresql://localhost:5432/chatbot_saas
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# --- Secrets -------------------------------------------------------------------------------
# AES key for Meta Page tokens and QPay passwords at rest: exactly 16, 24 or 32 characters.
# Never change it once shops are connected (their stored tokens would become unreadable).
ENCRYPTION_SECRET_KEY=set_32_unique_characters_here___
# Signs Meta connect links and QPay callback URLs; must differ from ENCRYPTION_SECRET_KEY
OAUTH_STATE_SECRET=set_a_unique_random_value_here
# Operator account for /api/admin/** (suspend/activate shops, owner login links)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set_a_strong_unique_password_here
# The dashboard is served from the same origin, so no browser origin needs CORS; list any
# other web app that calls the API from a browser (never '*')
CORS_ALLOWED_ORIGINS=https://shop.example.mn

# --- Meta (Facebook / Instagram) -----------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WEBHOOK_VERIFY_TOKEN=set_a_unique_random_value_here
# Graph API version used for all Meta calls - bump before Meta deprecates it
META_GRAPH_API_VERSION=v23.0
# How long a Facebook/Instagram connect link stays valid, in minutes
OAUTH_STATE_TTL_MINUTES=60
# Permissions the Facebook connect asks for. Meta refuses any your app has no use case for
# ("Invalid Scopes"); for Messenger only, drop the two instagram_* entries.
META_OAUTH_SCOPES=pages_show_list,pages_messaging,pages_manage_metadata,instagram_basic,instagram_manage_messages

# --- QPay ----------------------------------------------------------------------------------
# Each shop connects its own QPay merchant account in the dashboard, so no QPay credentials
# go here. Production: https://merchant.qpay.mn/v2 (startup refuses the sandbox under prod).
# For testing: https://merchant-sandbox.qpay.mn/v2 with SPRING_PROFILES_ACTIVE unset.
QPAY_API_URL=https://merchant.qpay.mn/v2
# Unpaid invoices younger than this are re-checked in case QPay's callback was missed
QPAY_RECONCILE_WINDOW_HOURS=3

# --- Dashboard sign-in ---------------------------------------------------------------------
# true: anyone can create a shop from the sign-up page. false: onboard shops via the admin API
SIGNUP_ENABLED=true
# Idle time before a dashboard session expires
SESSION_TIMEOUT=12h
AUTH_INVITE_TTL_HOURS=72
AUTH_RESET_TTL_HOURS=24

# --- Chatbot behaviour ---------------------------------------------------------------------
# Idle hours before an unfinished chatbot order conversation is abandoned
CHATBOT_CONVERSATION_TIMEOUT_HOURS=24
# Hours the bot stays silent for a customer after they ask for a person or staff reply
CHATBOT_HANDOFF_TIMEOUT_HOURS=12

# --- Operations ----------------------------------------------------------------------------
# INFO in production; DEBUG logs customer IDs and message metadata
LOG_LEVEL=INFO
# "native" trusts X-Forwarded-For only from private-network proxies (Caddy); "none" if no proxy
FORWARD_HEADERS_STRATEGY=native
# The app's port on the server itself (bound to 127.0.0.1 only)
APP_PORT=8080

# --- Optional legacy Directus catalog UI (docker compose --profile directus) ---------------
# Shops now manage products and photos in the dashboard. Set DIRECTUS_PUBLIC_URL only if
# products still have photos that were uploaded through Directus, so their URLs keep working.
DIRECTUS_DB_PASSWORD=
DIRECTUS_PUBLIC_URL=
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
